# Supabase PostgreSQL Database Configuration
# DATABASE_URL: Transaction Pooler connection string (port 6543) - used by serverless runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection string (port 5432) - used for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Vercel Environment Variables
PORT=3001
NODE_ENV=production
CRON_SECRET="your_vercel_cron_secret_key_here"

# Telemetry Simulator Defaults
SIMULATOR_DEFAULT_INTERVAL_SEC=5
