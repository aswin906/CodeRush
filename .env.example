# Server Configuration (Vercel Environment Variables)
PORT=3001
NODE_ENV=production

# Database Connection (Hosted PostgreSQL e.g. Neon / Supabase / Prisma Accelerate)
DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-2.aws.neon.tech/agrosense?sslmode=require"

# Vercel Cron Security Secret
CRON_SECRET="your_vercel_cron_secret_key_here"

# Telemetry Simulator Defaults
SIMULATOR_DEFAULT_INTERVAL_SEC=5
